BACK_BIND=0.0.0.0:8080
OLDIF_DB_URL=http://oldif-back-db:8081
# Set to select gRPC. Unset selects HTTP; gRPC errors never fall back to HTTP.
OLDIF_DB_GRPC_URL=http://oldif-back-db:50053
DB_CONNECT_TIMEOUT_SECONDS=5
# Complete database call, including all streamed list records, bounded to 1–120s.
DB_REQUEST_TIMEOUT_SECONDS=120
OLDIF_CORE_URL=http://oldif-ai-core:8082
OLDIF_CORE_GRPC_URL=http://oldif-ai-core:50052
# Channel setup timeout; both values are bounded to 1–120 seconds.
CORE_CONNECT_TIMEOUT_SECONDS=5
# Total unary/subscription-open deadline, including setup and response decoding.
# Established event streams have no total lifetime deadline.
CORE_REQUEST_TIMEOUT_SECONDS=20
# Database credential; all service pairs use distinct values in Azure.
OLDIF_CORE_TOKEN=replace-with-unique-backend-core-token
OLDIF_COVENANT_TOKEN=replace-with-unique-backend-covenant-token
OLDIF_ALLOW_SHARED_LOCAL_TOKEN=false
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
SESSION_SECONDS=86400
MAX_ACTIVE_RUNS=4
IMAGE_TAG=dev
HOST_PORT=8080
OLDIF_COVENANT_URL=http://oldif-ai-covenant:8083
DOCUMENT_MAX_BYTES=16777216
DOCUMENT_MAX_PAGES=300
DOCUMENT_MAX_TEXT_BYTES=8388608
DOCUMENT_TIMEOUT_SECONDS=30
DOCUMENT_MEMORY_MB=512
POPPLER_BIN_DIR=/usr/bin
TESSERACT_EXECUTABLE=/usr/bin/tesseract
